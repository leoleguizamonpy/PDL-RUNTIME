{
  "name": "@leoleguizamon/pdl",
  "version": "2.0.0-alpha.3",
  "description": "PDL runtime: reusable visual primitives, CSS and product-neutral interaction utilities.",
  "type": "module",
  "types": "./src/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./css": {
      "types": "./src/css.d.ts",
      "default": "./src/css/index.css"
    },
    "./css/core": "./src/css/entries/core.css",
    "./css/family/*": "./src/css/entries/family-*.css",
    "./js/family/*": {
      "types": "./src/js/families/*.d.ts",
      "default": "./src/js/families/*.js"
    },
    "./app": "./src/app/index.js",
    "./runtime": "./src/js/runtime.js",
    "./notifications": "./src/js/notifications.js",
    "./workspace": "./src/js/workspace.js",
    "./css/bundle": "./src/css/pdl.css",
    "./manifest-schema": "./schemas/product-ui.schema.json"
  },
  "bin": {
    "pdl-check": "./bin/pdl-check.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
